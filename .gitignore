# ==============================================================================
# 🐍 PYTHON ARCHITECTURE AND RUNTIME EXCLUSIONS
# ==============================================================================
# Bytecompiled / optimized / cached bytecode files
__pycache__/
*.py[cod]
*$py.class

# C extensions and dynamic libraries compiled at execution
*.so

# Distribution / packaging utilities
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# 🛠️ VIRTUAL ENVIRONMENTS AND RUNTIME PACKAGES
# ==============================================================================
# Local environment directory isolation
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Conda local environment artifacts
.conda/
conda-bld/

# ==============================================================================
# 📊 DATA AND TEMPORARY TELEMETRY EXTRACTIONS
# ==============================================================================
# Raw hardware log captures and test logs
*.log
*.csv
*.tsv
*.dat
*.out
.cache/

# NumPy structural memory dumps and test tensors
*.npy
*.npz

# ==============================================================================
# 🛡️ SECURITY AND TESTING ENGINE FRAMEWORKS
# ==============================================================================
# Local cryptographic parameters (Private key blocks must never be tracked)
*.key
*.pem
*.pub
*.secret

# Automated test runner framework configurations
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ==============================================================================
# 💻 OPERATING SYSTEM AND LOCAL DISK METADATA
# ==============================================================================
# macOS structural indexing caches
.DS_Store
.AppleDouble
.LSOverride

# Windows desktop layout caches
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux system buffers
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


