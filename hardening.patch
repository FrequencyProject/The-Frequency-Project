+import pytest
+import numpy as np
+from prototype_simulation import (
+    process_to_frequency_vector, 
+    apply_log_min_max_normalization,
+    execute_ecological_ingestion_pipeline
+)
+
+def test_invalid_input_validation():
+    """Verifies that public entry functions properly reject invalid parameter inputs."""
+    valid_frame = np.sin(np.linspace(0, 10, 100))
+    
+    with pytest.raises(ValueError, match="Sampling rate must be strictly positive"):
+        process_to_frequency_vector(valid_frame, sampling_rate=0, target_dim=1280)
+        
+    with pytest.raises(ValueError, match="Target dimension must be greater than 2"):
+        process_to_frequency_vector(valid_frame, sampling_rate=1000, target_dim=2)
+        
+    with pytest.raises(ValueError, match="contains non-finite values"):
+        nan_frame = np.array([1.0, np.nan, 3.0])
+        process_to_frequency_vector(nan_frame, sampling_rate=1000, target_dim=1280)
+
+def test_pipeline_shape_and_determinism():
+    """Ensures the core execution layer accurately processes anchors into fixed matrix structures."""
+    rng = np.random.default_rng(seed=42)
+    channels = {
+        'geophysical': {'frame': rng.normal(0, 1, 500), 'sampling_rate': 250},
+        'biological': {'frame': rng.normal(0, 1, 1000), 'sampling_rate': 1000}
+    }
+    matrix = execute_ecological_ingestion_pipeline(channels, target_dim=1280)
+    assert matrix.shape == (2, 1280)
