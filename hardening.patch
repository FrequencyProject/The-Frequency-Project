+import numpy as np
+
+def apply_log_min_max_normalization(vector: np.ndarray, eps: float = 1e-12) -> np.ndarray:
+    """Applies log scaling followed by min-max normalization."""
+    if not np.isfinite(vector).all():
+        raise ValueError("Input vector contains non-finite values (NaN or Inf).")
+    
+    log_v = np.log1p(np.maximum(vector, 0.0))
+    v_min = np.min(log_v)
+    v_max = np.max(log_v)
+    
+    denom = max(v_max - v_min, eps)
+    return (log_v - v_min) / denom
+
+def process_to_frequency_vector(frame: np.ndarray, sampling_rate: float, target_dim: int) -> np.ndarray:
+    """Processes a raw time-domain signal frame into a standardized frequency magnitude vector."""
+    if sampling_rate <= 0:
+        raise ValueError("Sampling rate must be strictly positive.")
+    if target_dim <= 2:
+        raise ValueError("Target dimension must be greater than 2.")
+    if not np.isfinite(frame).all():
+        raise ValueError("Input frame contains non-finite values.")
+        
+    nfft = 2 * (target_dim - 1)
+    
+    # Trim or pad frame to match exact window length
+    if len(frame) > nfft:
+        frame = frame[:nfft]
+    elif len(frame) < nfft:
+        frame = np.pad(frame, (0, nfft - len(frame)), mode='constant')
+        
+    window = np.hanning(nfft)
+    windowed_frame = frame * window
+    
+    fft_vals = np.abs(np.fft.rfft(windowed_frame, n=nfft))
+    
+    # Absolute magnitude convention normalization applied here
+    fft_vals = fft_vals / nfft
+    
+    if len(fft_vals) > target_dim:
+        fft_vals = fft_vals[:target_dim]
+    elif len(fft_vals) < target_dim:
+        fft_vals = np.pad(fft_vals, (0, target_dim - len(fft_vals)), mode='constant')
+        
+    return fft_vals
+
+def execute_ecological_ingestion_pipeline(channels: dict, target_dim: int = 1280) -> np.ndarray:
+    """Runs the full ingestion pipeline over global, biotic, and molecular anchors."""
+    processed_vectors = []
+    for name, config in channels.items():
+        freq_vector = process_to_frequency_vector(config['frame'], config['sampling_rate'], target_dim)
+        norm_vector = apply_log_min_max_normalization(freq_vector)
+        processed_vectors.append(norm_vector)
+        
+    return np.stack(processed_vectors, axis=0)
