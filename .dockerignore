# Exclude git metadata and version tracking nodes
.git
.gitignore

# Exclude local python execution caches and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
the_frequency_project.egg-info/
build/
dist/
wheels/
venv/

# Exclude raw testing modules and configuration manuals from production layers
tests/
*.md
